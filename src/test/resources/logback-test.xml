<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
    <!-- the services log every rejected request at ERROR; tests assert those paths deliberately -->
    <logger name="com.teenthofabud.videoconference.mdr" level="OFF"/>
</configuration>
