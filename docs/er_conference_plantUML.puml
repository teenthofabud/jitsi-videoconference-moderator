@startuml

class User {
  +id
  +name
  +userId
  +userIdHash
  +referenceType
}

class Server {
  +id
  +name
  +serverUrl
  +severType
}

class Meeting {
  +id
  +roomId
  +eventId
  +status
  +userId
  +serverId
}

enum ReferenceType{
 +Email
}

enum ServerType{
 +Custom
 +Default
}

User --> ReferenceType : reference type

Server --> ServerType : server type

User "1" <..> "N" Meeting : creates
/'//cardinality changes if relationship becomes participates'/
Meeting "N" <..> "1" Server : hosted on

User "1" <..> "N" Server : brings

@enduml







