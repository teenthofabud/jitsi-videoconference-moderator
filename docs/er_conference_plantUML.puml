@startuml

class User {
  +id
  +name
  +userId
  +userIdHash
  +referenceType
}

class Server {
  +id
  +name
  +serverUrl
  +serverPreferences
}

class Meeting {
  +id
  +roomId
  +eventId
  +status
  +serverPreferenceId
}

class ServerPreference {
  +id
  +serverUrl
  +userIdHash
  +sevrerPreferenceType
}

enum ReferenceType{
 +Email
}

enum ServerPreferenceType{
 +Custom
 +Default
}

User --> ReferenceType : reference type

ServerPreference --> ServerPreferenceType : preference type

User "1" <..> "N" Meeting : creates
/'//cardinality changes if relationship becomes participates'/
Meeting "N" <..> "1" Server : hosted on

User "1" <..> "1" ServerPreference : has
ServerPreference "N" <--> "1" Server : requires

@enduml







