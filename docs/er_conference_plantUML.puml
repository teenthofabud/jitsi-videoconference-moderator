    @startuml

    class User {
      +id
      +name
      +email
      +referenceType
    }

    class Server {
      +id
      +name
      +serverUrl
      +severType
      +ownerEmail
    }

    class Conference {
      +id
      +roomId
      +eventId
      +conferenceStatus
      +createdBy
    }

    enum ReferenceType{
     +Email
    }

    enum ServerType{
     +Custom
     +Default
    }

    enum ConferenceStatus{
     +Active
     +Pending
     +Cancelled
    }


    User --> ReferenceType : reference type

    Server --> ServerType : server type



    User "1" <..> "1" Server : brings

    Conference --> ConferenceStatus : conference status

    @enduml


