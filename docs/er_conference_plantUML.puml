@startuml

class User {
  +id
  +name
  +userId
  +referenceType
}

class Server {
  +id
  +name
  +serverUrl
}

class Meeting {
  +id
  +roomId
  +userId
  +baseUrl
  +status
}

class ServerPreference {
  +id
  +serverUrl
  +userId
}

enum ReferenceType{
 +Email
}

User --> ReferenceType : referenceType

User "1" <--> "N" Meeting : creates 
/'//cardinality changes if relationship becomes participates'/
Meeting "N" <--> "1" Server : hosted on

User "1" --> "N" ServerPreference : has
ServerPreference "*" --> "1" Server : prefers

@enduml

