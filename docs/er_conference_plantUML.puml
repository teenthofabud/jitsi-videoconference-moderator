@startuml

class User {
  +id
  +name
  +email
  +managed
}

class Server {
  +id
  +name
  +serverUrl
  +serverType
  +userId
}

class Conference {
  +id
  +roomId
  +userId
  +serverId
  +status
  +version
  +lastModifiedDate
}

class GoogleConference {
  +eventId
}

class CalComConference {
  +bookingUid
  +bookingId
}

class OutlookConference {
  +draftTrackingId
  +eventId
}

class OutlookGraphConnection {
  +userId
  +microsoftUserId
  +mailboxEmail
  +tenantId
  +accessTokenEncrypted
  +refreshTokenEncrypted
  +accessTokenExpiresAt
  +subscriptionId
  +subscriptionExpiresAt
  +subscriptionClientState
  +pendingStateHash
  +pendingCodeVerifier
  +pendingExpiresAt
  +connectionStatus
  +lastSyncError
  +reconciliationRequired
  +version
  +lastModifiedDate
}

enum ServerType {
  +Custom
  +Default
}

enum ConferenceStatus {
  +Active
  +Pending
  +Cancelled
}

GoogleConference --|> Conference
CalComConference --|> Conference
OutlookConference --|> Conference

Server --> ServerType : server type
Conference --> ConferenceStatus : conference status

User "1 " <..> "M" Conference : owns
Server "1 " <..> "M" Conference : uses
User "1 " -- "0..1 " OutlookGraphConnection : connects

note right of OutlookConference
  eventId is captured when the add-in saves
  the appointment, then matched against
  Graph change notifications.
end note

note right of OutlookGraphConnection
  One connection record stores the user's
  delegated Graph tokens and calendar
  subscription state.
end note

@enduml
